@page "{id:int}"
@model GarmentLotManager.Pages.Karigars.LedgerModel
@{
    var k = Model.KarigarItem;
    ViewData["Title"] = $"{k.Name} - Ledger";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3 no-print">
            <a asp-page="/Karigars/Index" class="btn btn-outline-secondary btn-sm">
                ← <span class="lang-hi">સબ કારીગરોં પર વાપસ જાઓ</span><span class="lang-en">Back to Karigars</span>
            </a>
            <button type="button" onclick="window.print()" class="btn btn-dark btn-sm fw-bold">
                🖨️ <span class="lang-hi">પરચી પ્રિન્ટ કરો</span><span class="lang-en">Print Passbook</span>
            </button>
        </div>

        <div class="card-custom bg-white p-4 p-md-5 invoice-container shadow-sm">
            <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 1.5rem;">
                        @k.Name.Substring(0, 1)
                    </div>
                    <div>
                        <h2 class="h4 fw-bold text-dark mb-0">@k.Name</h2>
                        <div class="small text-muted">
                            <span class="lang-hi">ઉમ્ર:</span><span class="lang-en">Age:</span> 
                            <strong>@(k.Age.HasValue ? $"{k.Age} yrs" : "-")</strong>
                        </div>
                        <div class="small text-muted">
                            <span class="lang-hi">ડિફોલ્ટ રેટ:</span><span class="lang-en">Default Rate:</span> 
                            <strong>₹@k.DefaultRate/<span class="lang-hi">પીસ</span><span class="lang-en">pc</span></strong>
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge bg-primary fs-6 px-3 py-2">
                        <span class="lang-hi">કારીગર ખાતા (પાસબુક)</span>
                        <span class="lang-en">Artisan Ledger</span>
                    </span>
                    <div class="small text-muted mt-1">
                        @DateTime.Today.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>

            <div class="row g-2 mb-4">
                <div class="col-6">
                    <div class="p-3 bg-light rounded-3 border text-center">
                        <div class="text-muted small">
                            <span class="lang-hi">કુલ સિયે ગયે પીસ</span>
                            <span class="lang-en">Total Stitched Pieces</span>
                        </div>
                        <div class="fw-bold fs-4 text-dark">
                            @Model.TotalPieces.ToString("N0") <span class="lang-hi">પીસ</span><span class="lang-en">pcs</span>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 bg-success bg-opacity-10 rounded-3 border border-success border-opacity-25 text-center">
                        <div class="text-muted small">
                            <span class="lang-hi">કુલ મજદૂરી કમાઈ</span>
                            <span class="lang-en">Total Wages Earned</span>
                        </div>
                        <div class="fw-bold fs-4 text-success">₹@Model.TotalEarnings.ToString("N0")</div>
                    </div>
                </div>
            </div>

            <h3 class="h6 fw-bold text-dark mb-2">
                📋 <span class="lang-hi">લોટ-વાર કામ વ મજદૂરી વિવરણ</span>
                <span class="lang-en">Lot-wise Work & Wages History</span>
            </h3>
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-dark small">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th><span class="lang-hi">લોટ નંબર</span><span class="lang-en">Lot No.</span></th>
                            <th><span class="lang-hi">તારીખ</span><span class="lang-en">Date</span></th>
                            <th><span class="lang-hi">આઇટમ</span><span class="lang-en">Item</span></th>
                            <th class="text-center"><span class="lang-hi">પીસ</span><span class="lang-en">Pieces</span></th>
                            <th class="text-end"><span class="lang-hi">રેટ (₹)</span><span class="lang-en">Rate (₹)</span></th>
                            <th class="text-end"><span class="lang-hi">મજદૂરી (₹)</span><span class="lang-en">Amount (₹)</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.History.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No work records found</td>
                            </tr>
                        }
                        else
                        {
                            int idx = 1;
                            foreach (var item in Model.History)
                            {
                                var entry = item.Lot.StitchingEntries.FirstOrDefault(e => e.KarigarId == k.Id);
                                decimal rate = entry != null ? entry.RatePerPiece : k.DefaultRate;
                                <tr>
                                    <td>@(idx++)</td>
                                    <td><span class="badge bg-dark">@item.Lot.LotNumber</span></td>
                                    <td class="small">@(item.Lot.StartDate.HasValue ? item.Lot.StartDate.Value.ToString("dd/MM/yyyy") : "")</td>
                                    <td>@item.Lot.ItemName</td>
                                    <td class="text-center fw-bold">@item.Pieces</td>
                                    <td class="text-end">₹@rate.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">₹@item.Amount.ToString("N0")</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="4" class="text-end">
                                <span class="lang-hi">કુલ:</span><span class="lang-en">Total:</span>
                            </td>
                            <td class="text-center fs-6">@Model.TotalPieces <span class="lang-hi">પીસ</span><span class="lang-en">pcs</span></td>
                            <td></td>
                            <td class="text-end text-success fs-5">₹@Model.TotalEarnings.ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
